# Host-installed Nginx example. Replace domain and certificate paths before enabling.
# If Nginx runs in Docker, use a shared Docker network and netnama:8080 instead:
# 127.0.0.1 inside that Nginx container is NOT the host or the app container.
server {
    listen 80;
    server_name netnama.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name netnama.example.com;
    ssl_certificate /etc/letsencrypt/live/netnama.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/netnama.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Domain queries and job URLs should not be written to access logs.
    access_log off;
    client_max_body_size 2m;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;
    }
}
