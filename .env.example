# Docker Compose uses this file automatically. No .env or manual setup is needed.
# Start: docker compose up -d --build
# Open: http://localhost:8080 (or http://SERVER_IP:8080)
# First login: admin / 123456. You can change the password in the app settings.
NETNAMA_USERNAME=admin
NETNAMA_PASSWORD=123456

# Optional. Empty = generate once and persist automatically in the data volume.
NETNAMA_SECRET_KEY=
# false works over HTTP. Set true if you later enable HTTPS at a reverse proxy.
NETNAMA_HTTPS=false

# Native Python defaults. Compose sets public / 0.0.0.0 / 8080 inside the container.
# The Python app does not read this file automatically when run without Compose.
NETNAMA_MODE=local
NETNAMA_HOST=127.0.0.1
NETNAMA_PORT=8080
NETNAMA_ALLOW_PRIVATE_TARGETS=false
NETNAMA_RESULT_TTL=900
NETNAMA_MAX_RAM_MB=48

# Optional overrides: edit this file or create an untracked .env.
# Username/password apply on FIRST bootstrap only; change existing passwords in the app.
# NETNAMA_DATA_DIR=/path/to/private/data
# NETNAMA_PASSWORD_HASH=werkzeug-password-hash
# Host port/bind and memory overrides go in .env or the shell (Compose interpolation):
# NETNAMA_HTTP_PORT=9090
# NETNAMA_BIND_ADDRESS=127.0.0.1
# NETNAMA_MEMORY_LIMIT=512m
