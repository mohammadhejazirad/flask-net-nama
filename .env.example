# Local default: http://127.0.0.1:8080, admin / 123456
NETNAMA_MODE=local
NETNAMA_HOST=127.0.0.1
NETNAMA_PORT=8080
# NETNAMA_DATA_DIR=/path/to/private/data
NETNAMA_ALLOW_PRIVATE_TARGETS=false
NETNAMA_HTTPS=false
# Applied at FIRST bootstrap only; subsequent changes use the settings page.
# NETNAMA_USERNAME=admin
# NETNAMA_PASSWORD=replace-with-a-long-unique-password
# NETNAMA_PASSWORD_HASH=werkzeug-password-hash
# Required explicitly for public mode (32+ random characters):
# NETNAMA_SECRET_KEY=generate-with-python-secrets-token-hex
# Result retention seconds: 30..3600; job admission RAM MiB: 8..256.
NETNAMA_RESULT_TTL=900
NETNAMA_MAX_RAM_MB=48
